{
  "name": "tabmd",
  "description": "Local-first Markdown notes in every new tab.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:e2e": "wxt build -c tests/e2e/wxt.e2e.config.ts -m e2e",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "icons:generate": "node scripts/generate-icons.mjs",
    "quality": "pnpm compile && pnpm lint",
    "smoke": "node scripts/smoke.mjs",
    "package": "pnpm zip",
    "postinstall": "wxt prepare",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "pnpm build:e2e && playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.1.43",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "wxt": "^0.20.27"
  },
  "dependencies": {
    "easymde": "^2.21.0",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.13"
  },
  "pnpm": {
    "overrides": {
      "adm-zip": "0.6.0",
      "esbuild": "0.28.2",
      "shell-quote": "1.9.0",
      "tmp": "0.2.7",
      "uuid": "11.1.1"
    }
  }
}
